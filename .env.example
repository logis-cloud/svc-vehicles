# Copiar a .env y ajustar si hace falta.
# En LOCAL, estas variables coinciden con los defaults de docker-compose.yml.
# En PRODUCCIÓN, DB_HOST debe apuntar a la IP privada de la 3ra VM (base de
# datos), no al nombre del contenedor "db-vehiculos" (eso solo funciona en
# docker compose de un solo host).

DB_NAME=vehiculos_db
DB_USER=postgres
DB_PASSWORD=postgres

# Solo poner en true para cargar datos ficticios una única vez (ver README).
# Debe quedar en false el resto del tiempo, incluido en producción.
SEED_ENABLED=false
